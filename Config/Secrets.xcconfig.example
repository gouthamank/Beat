// Copy to Config/Secrets.xcconfig (git-ignored) and fill in your Last.fm API account
// (https://www.last.fm/api/account/create), then run `xcodegen generate` and build.
LASTFM_API_KEY = your_api_key
LASTFM_SHARED_SECRET = your_shared_secret

// iPad and iPhone builds on a device: your Apple ID's team ID (Xcode > Settings > Accounts > select the team; it's
// also in the Membership details at developer.apple.com). A free Apple ID's "Personal Team" works.
DEVELOPMENT_TEAM = your_team_id
