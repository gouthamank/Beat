---
// The hero's backdrop: rows of the made-up library's covers, tilted back and drifting sideways in turn. Decorative, so
// hidden from screen readers; still for anyone who prefers reduced motion.
import { Image } from 'astro:assets';
import { albums } from '../data/showcase';

const rows = 4;
const perRow = Math.ceil(albums.length / rows);
// Each row's set repeats its covers three times over (about 6,000 px), wider than any screen even tilted, so the
// drift never shows an end.
const lines = Array.from({ length: rows }, (_, i) => {
  const line = albums.slice(i * perRow, (i + 1) * perRow);
  return [...line, ...line, ...line];
});
---

<div class="wall pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <div class="tilt">
    {lines.map((line, i) => (
      <div class:list={['row', i % 2 ? 'right' : 'left']}>
        {/* The set three times over: the drift moves one set, starting one set in, so neither end is ever near. */}
        {[...line, ...line, ...line].map((album) => (
          <Image src={album.image} alt="" width={220} height={220} loading="eager" class="cover" />
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .wall {
    /* Clear behind the headline and buttons, the covers showing round the edges. */
    mask-image: linear-gradient(to right, black 0%, transparent 30%, transparent 70%, black 100%);
    opacity: 0.6;
  }
  .tilt {
    position: absolute;
    inset: -10% -20%;
    display: flex;
    flex-direction: column;
    gap: 18px;
    justify-content: center;
    transform: perspective(1400px) rotateX(28deg) rotateZ(-8deg);
  }
  .row {
    display: flex;
    gap: 18px;
    /* One gap after the last cover, so a third of the row is exactly one set and the loop joins without a jump. */
    padding-right: 18px;
    width: max-content;
  }
  .row.left { animation: drift 270s linear infinite; }
  .row.right { animation: drift 330s linear infinite reverse; }
  .cover {
    width: 180px;
    height: 180px;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
  }
  @keyframes drift {
    from { transform: translateX(-33.333%); }
    to { transform: translateX(-66.667%); }
  }
  /* A phone has no sides to spare: a faint wall behind everything instead. */
  @media (max-width: 640px) {
    .wall { mask-image: none; opacity: 0.12; }
    .cover { width: 120px; height: 120px; }
  }
</style>
