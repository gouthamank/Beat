---
// Mac to iPhone, as you scroll: the section pins, the Mac window narrows into a phone showing the same Home, then Now
// Playing opens out of the now-playing bar with the cover flying up from the bar's thumbnail, as in the app. Three
// screenshots (home-mac, home-iphone, now-playing-iphone, all playing Glow Season) and the cover itself; the frames
// in between are drawn here. With reduced motion, the shots sit side by side instead.
import { getImage } from 'astro:assets';
import Shot from './Shot.astro';
import { albums } from '../data/showcase';

const album = albums.find((a) => a.title === 'Glow Season')!;
const cover = (await getImage({ src: album.image, width: 800, height: 800, format: 'webp' })).src;
---

<div data-morph-static class="mx-auto mt-12 max-w-6xl">
  <Shot name="home-mac" alt="Home on the Mac" />
  <div class="mx-auto mt-10 grid max-w-xl grid-cols-2 gap-4 sm:gap-8">
    <Shot name="home-iphone" alt="Home on iPhone, playing Glow Season" aspect="9 / 19.5" class="rounded-[1.4rem]! sm:rounded-[1.9rem]!" />
    <Shot name="now-playing-iphone" alt="Now Playing on iPhone" aspect="9 / 19.5" class="rounded-[1.4rem]! sm:rounded-[1.9rem]!" />
  </div>
</div>

<div data-morph hidden class="morph relative">
  <div class="stage sticky">
    <div data-frame class="frame absolute overflow-hidden bg-raised shadow-[0_20px_60px_rgb(0_0_0/0.22)] ring-1 ring-line">
      <div data-layer="mac" class="layer free"><Shot name="home-mac" alt="Home on the Mac" class="rounded-none! shadow-none! ring-0!" /></div>
      <div data-layer="home" class="layer free"><Shot name="home-iphone" alt="Home on iPhone, playing Glow Season" class="rounded-none! shadow-none! ring-0!" /></div>
      <div data-layer="playing" class="layer"><Shot name="now-playing-iphone" alt="Now Playing on iPhone" class="rounded-none! shadow-none! ring-0!" /></div>
      <img data-cover src={cover} alt="" class="cover absolute" />
    </div>
  </div>
</div>

<style>
  .morph { height: 300vh; }
  .stage { top: var(--morph-top, 0px); height: calc(100svh - var(--morph-top, 0px)); }
  .frame { will-change: left, top, width, height; }
  .layer { position: absolute; inset: 0; }
  .layer :global(picture), .layer :global(img) { width: 100%; height: 100%; }
  /* The two Home pages are placed and scaled by the script, so their covers line up while the frame narrows. */
  .layer.free :global(img) { position: absolute; left: 0; top: 0; transform-origin: 0 0; max-width: none; }
  .cover { left: 0; top: 0; transform-origin: 0 0; will-change: transform, opacity; }
</style>

<script>
  // Where things sit in the shots, as fractions of the shot (measured from the 1206 × 2622 iPhone shots and the
  // 2800 × 1760 Mac one). Retaking a shot means measuring these again.
  const macAspect = 2800 / 1760;
  const phoneAspect = 1206 / 2622;
  const macRadius = 26 / 2800; // the window's corner, of its width
  const phoneRadius = 0.137; // the screen's corner, of its width
  const bar = { left: 39 / 1206, right: 39 / 1206, top: 2298 / 2622, bottom: 132 / 2622 };
  const thumb = { left: 78 / 1206, top: 2328 / 2622, size: 138 / 1206, radius: 0.16 };
  const big = { left: 60 / 1206, top: 404 / 2622, size: 1086 / 1206, radius: 0.04 };
  // The first Recently Added cover on each Home: its top-left corner and width. The morph keeps the two together.
  const macTile = { left: 350 / 2000, top: 177 / 1257, size: 240 / 2000 };
  const phoneTile = { left: 37 / 920, top: 571 / 2000, size: 343 / 920 };
  // The scroll, in parts: Mac, morph, iPhone Home, Now Playing opening, Now Playing.
  const morph = [0.06, 0.42];
  const open = [0.52, 0.9];

  const clamp = (x: number) => Math.min(1, Math.max(0, x));
  const ease = (x: number) => (x < 0.5 ? 4 * x * x * x : 1 - (-2 * x + 2) ** 3 / 2);
  const part = (p: number, [a, b]: number[]) => ease(clamp((p - a) / (b - a)));
  const mix = (a: number, b: number, t: number) => a + (b - a) * t;

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  for (const root of document.querySelectorAll<HTMLElement>('[data-morph]')) {
    const fallback = root.previousElementSibling as HTMLElement;
    const stage = root.firstElementChild as HTMLElement;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const mac = root.querySelector<HTMLElement>('[data-layer="mac"]')!;
    const macImage = mac.querySelector('img')!;
    const homeImage = root.querySelector<HTMLElement>('[data-layer="home"] img')!;
    const home = root.querySelector<HTMLElement>('[data-layer="home"]')!;
    const playing = root.querySelector<HTMLElement>('[data-layer="playing"]')!;
    const cover = root.querySelector<HTMLElement>('[data-cover]')!;
    // Every layer is in view from the start, so the browser loads them all before they're needed.
    for (const img of root.querySelectorAll('img')) img.loading = 'eager';

    const draw = () => {
      const header = document.querySelector('header')?.offsetHeight ?? 0;
      root.style.setProperty('--morph-top', `${header}px`);
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      const range = root.offsetHeight - h;
      const p = range > 0 ? clamp((header - root.getBoundingClientRect().top) / range) : 0;
      const m = part(p, morph);
      const o = part(p, open);

      // The frame: the Mac window's rectangle, narrowing into the phone's, both centred.
      const macW = Math.min(w - 32, 1152, (h - 48) * macAspect);
      const macH = macW / macAspect;
      const phoneH = Math.min(h - 48, (w - 32) / phoneAspect, 760);
      const phoneW = phoneH * phoneAspect;
      const fw = mix(macW, phoneW, m);
      const fh = mix(macH, phoneH, m);
      const radius = mix(macRadius * macW, phoneRadius * phoneW, m);
      Object.assign(frame.style, { left: `${(w - fw) / 2}px`, top: `${(h - fh) / 2}px`, width: `${fw}px`, height: `${fh}px`, borderRadius: `${radius}px` });

      // Both Home pages hang off one point, the first cover's corner, moving from where it is on the Mac to where it
      // is on the phone, and scale so their covers are the same size: the sidebar slides out, and the phone's Home
      // fades in over a page already the same shape.
      const ax = mix(macTile.left * macW, phoneTile.left * phoneW, m);
      const ay = mix(macTile.top * macH, phoneTile.top * phoneH, m);
      const tile = mix(macTile.size * macW, phoneTile.size * phoneW, m);
      const place = (image: HTMLElement, width: number, height: number, at: { left: number; top: number; size: number }) => {
        const scale = tile / (at.size * width);
        image.style.width = `${width}px`;
        image.style.height = `${height}px`;
        image.style.transform = `translate(${ax - at.left * width * scale}px, ${ay - at.top * height * scale}px) scale(${scale})`;
      };
      place(macImage, macW, macH, macTile);
      place(homeImage, phoneW, phoneH, phoneTile);
      // While the frame is still wider than the phone's page, its right edge fades out rather than showing a seam.
      homeImage.style.maskImage = m < 1 ? `linear-gradient(to right, #000 ${mix(70, 100, m)}%, transparent)` : '';
      mac.style.opacity = String(1 - clamp((m - 0.45) / 0.4));
      home.style.opacity = String(clamp((m - 0.25) / 0.4));

      // Now Playing grows out of the bar, its corners going from the bar's to none.
      const barH = (1 - bar.top - bar.bottom) * fh;
      const inset = [bar.top * fh, bar.right * fw, bar.bottom * fh, bar.left * fw].map((x) => `${mix(x, 0, o)}px`).join(' ');
      playing.style.clipPath = `inset(${inset} round ${mix(barH / 2, 0, o)}px)`;
      // Opaque within the first bit of scrolling, so the bar's own thumbnail is covered before the cover lifts off.
      const opened = clamp((p - open[0]) / (open[1] - open[0]));
      playing.style.opacity = String(clamp(opened / 0.12));
      home.style.filter = o > 0 ? `brightness(${mix(1, 0.7, o)})` : '';
      home.style.visibility = o < 1 ? '' : 'hidden'; // else its edges show along the rounded corners' antialiasing

      // The cover flies from the bar's thumbnail to the big cover, landing before the growing page reaches the shot's
      // own cover (so there's never two), and hands over to it once the page is open.
      const c = part(p, [mix(open[0], open[1], 0.08), mix(open[0], open[1], 0.42)]);
      const from = thumb.size * fw;
      const to = big.size * fw;
      const size = mix(from, to, c);
      cover.style.width = cover.style.height = `${to}px`;
      cover.style.borderRadius = `${mix(thumb.radius * from, big.radius * to, c) * (to / size)}px`;
      cover.style.transform = `translate(${mix(thumb.left * fw, big.left * fw, c)}px, ${mix(thumb.top * fh, big.top * fh, c)}px) scale(${size / to})`;
      cover.style.opacity = c > 0 && o < 1 ? '1' : '0';
    };

    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; draw(); });
    };
    const apply = () => {
      root.hidden = reduce.matches;
      fallback.hidden = !reduce.matches;
      if (!reduce.matches) draw();
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    reduce.addEventListener('change', apply);
    apply();
  }
</script>
