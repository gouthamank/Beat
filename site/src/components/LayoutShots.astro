---
// Four of the looks an element can take, as buttons: choosing one swaps in the screenshot of a page in that layout
// (layout-<key>-mac, light and dark). Every shot is in the page, stacked in one place, and the chosen one fades in over
// the last, so switching is immediate and every shot has loaded by the time it's picked; a few lines of script.
import Shot from './Shot.astro';

const layouts = [
  { key: 'grid', title: 'Grid' },
  { key: 'list', title: 'List' },
  { key: 'coverflow', title: 'Cover Flow' },
  { key: 'timeline', title: 'Timeline' },
];
const first = layouts[0].key;
---

<div class="layout-shots" data-layout-shots>
  <div class="flex flex-wrap gap-2" role="tablist" aria-label="Element layouts">
    {layouts.map(({ key, title }) => (
      <button type="button" role="tab" aria-selected={key === first ? 'true' : 'false'} aria-controls={`layout-${key}`}
              data-layout={key}
              class="cursor-pointer rounded-full border border-line bg-raised px-4 py-1.5 text-sm transition-colors hover:border-ink/30 aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-ink">
        {title}
      </button>
    ))}
  </div>
  <p class="mt-3 text-sm text-faint">Each element picks its own look, and rules can use any song field, including Beat's own play and skip counts.</p>
  <div class="mt-10 grid">
    {layouts.map(({ key, title }) => (
      <div id={`layout-${key}`} role="tabpanel" data-layout-panel={key} aria-hidden={key !== first ? 'true' : undefined} inert={key !== first}
           class:list={['[grid-area:1/1] transition-opacity duration-500 ease-out motion-reduce:transition-none', key !== first && 'opacity-0']}>
        <Shot name={`layout-${key}-mac`} alt={`A page with an element in the ${title} layout, in Beat on the Mac`} />
      </div>
    ))}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-layout-shots]')) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-layout]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-layout-panel]')];
    const choose = (key: string) => {
      for (const b of buttons) b.setAttribute('aria-selected', String(b.dataset.layout === key));
      for (const p of panels) {
        const shown = p.dataset.layoutPanel === key;
        p.classList.toggle('opacity-0', !shown);
        p.inert = !shown;
        if (shown) p.removeAttribute('aria-hidden');
        else p.setAttribute('aria-hidden', 'true');
      }
    };
    buttons.forEach((button, i) => {
      button.addEventListener('click', () => choose(button.dataset.layout!));
      // Arrow keys move between the buttons, as in any set of tabs.
      button.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        const next = buttons[(i + step + buttons.length) % buttons.length];
        next.focus();
        choose(next.dataset.layout!);
      });
    });
  }
</script>
