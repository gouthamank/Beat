---
// A screenshot of the real app, from src/assets/shots/<name>-light.png and <name>-dark.png (taken from the showcase
// library with Design/Showcase/capture.sh, never a real library). The visitor sees the one matching their system;
// with only one taken, it's shown either way. Until there is one, a placeholder of the same shape says which goes there.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  /** Width over height of the shot: a Mac window by default. */
  aspect?: string;
  class?: string;
  /** Tilts towards the pointer on hover (see the script below); off where something else moves the shot. */
  tilt?: boolean;
}

const { name, alt, aspect = '16 / 10', class: className, tilt = true } = Astro.props;
const shots = import.meta.glob<ImageMetadata>('../assets/shots/*.png', { eager: true, import: 'default' });
const light = shots[`../assets/shots/${name}-light.png`];
const dark = shots[`../assets/shots/${name}-dark.png`];
const widths = [640, 1280, 1920];
const sizes = '(max-width: 1024px) 100vw, 960px';

async function sources(image: ImageMetadata | undefined) {
  if (!image) return undefined;
  const set = async (format: 'avif' | 'webp') =>
    // Every standard width the shot covers, plus its own: a narrow capture (a sheet, say) would otherwise offer only
    // 640 and look soft on a Retina screen.
    (await Promise.all([...widths.filter((w) => w < image.width), Math.min(image.width, widths.at(-1)!)].map(async (w) =>
      `${(await getImage({ src: image, width: w, format })).src} ${w}w`))).join(', ');
  return { avif: await set('avif'), webp: await set('webp'), fallback: (await getImage({ src: image, width: Math.min(1280, image.width), format: 'webp' })).src, image };
}

const lightSet = await sources(light ?? dark);
const darkSet = light && dark ? await sources(dark) : undefined;
---

{lightSet ? (
  <picture data-tilt={tilt ? '' : undefined} class:list={['block overflow-hidden rounded-xl shadow-[0_20px_60px_rgb(0_0_0/0.22)] ring-1 ring-line', className]}>
    {darkSet && <source media="(prefers-color-scheme: dark)" type="image/avif" srcset={darkSet.avif} sizes={sizes} />}
    {darkSet && <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkSet.webp} sizes={sizes} />}
    <source type="image/avif" srcset={lightSet.avif} sizes={sizes} />
    <source type="image/webp" srcset={lightSet.webp} sizes={sizes} />
    <img src={lightSet.fallback} alt={alt} width={lightSet.image.width} height={lightSet.image.height} loading="lazy" decoding="async"
         class="h-auto w-full" />
  </picture>
) : (
  <div class:list={['grid place-items-center rounded-2xl border border-dashed border-line bg-raised p-6 text-center text-sm text-faint', className]}
       style={`aspect-ratio: ${aspect}`} role="img" aria-label={alt}>
    <span>Screenshot to come: <code>{name}</code><br />{alt}</span>
  </div>
)}

<script>
  // Screenshots (and anything else marked data-tilt) lean a few degrees towards the pointer, like a card picked up off
  // a table. Mouse and trackpad only, and never with Reduce Motion; nothing runs until the pointer is over one.
  const hover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const lessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const maxDegrees = 2;
  for (const el of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
    let frame = 0;
    el.addEventListener('pointermove', (e) => {
      if (!hover.matches || lessMotion.matches) return;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.transition = 'transform 120ms ease-out';
        el.style.transform = `perspective(1400px) rotateX(${(-y * maxDegrees * 2).toFixed(2)}deg) rotateY(${(x * maxDegrees * 2).toFixed(2)}deg) scale(1.005)`;
      });
    });
    el.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      el.style.transition = 'transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1)';
      el.style.transform = '';
    });
  }
</script>
