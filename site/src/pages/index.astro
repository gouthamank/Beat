---
import { getImage, Image } from 'astro:assets';
import icon from '../assets/icon.png';
import CoverWall from '../components/CoverWall.astro';
import DeviceMorph from '../components/DeviceMorph.astro';
import LayoutShots from '../components/LayoutShots.astro';
import Shot from '../components/Shot.astro';
import Demo from '../demo/Demo';
import { Icon } from '../demo/Icon';
import type { DemoAlbum } from '../demo/model';
import Layout from '../layouts/Layout.astro';
import { albums, credits } from '../data/showcase';
import visualizerVideo from '../assets/video/visualizer.mp4?url';
import visualizerFrame from '../assets/video/visualizer-poster.png';

// The demo's library: covers resized for it, the few songs with real music given their files' URLs, and the ones with
// vocals their synced lyrics, read from the same .lrc files Beat reads.
const audioFiles = import.meta.glob<string>('../../../Design/Showcase/Audio/*', { eager: true, query: '?url', import: 'default' });
const lyricFiles = import.meta.glob<string>('../../../Design/Showcase/Lyrics/*.lrc', { eager: true, query: '?raw', import: 'default' });
const lyrics = (path?: string) => {
  const text = path ? lyricFiles[`../../../Design/Showcase/${path}`] : undefined;
  return text?.split('\n').flatMap((line) => {
    const m = line.match(/^\[(\d+):(\d+(?:\.\d+)?)\]\s*(.*)$/);
    return m && m[3] ? [{ time: Number(m[1]) * 60 + Number(m[2]), text: m[3] }] : [];
  });
};
const library: DemoAlbum[] = await Promise.all(albums.map(async (album) => ({
  id: album.id, title: album.title, artist: album.artist, genre: album.genre, year: album.year,
  addedDaysAgo: album.addedDaysAgo, comments: album.comments, palette: album.palette,
  cover: (await getImage({ src: album.image, width: 320, height: 320, format: 'webp' })).src,
  coverLarge: (await getImage({ src: album.image, width: 800, height: 800, format: 'webp' })).src,
  songs: album.songs.map((song) => ({
    title: song.title, track: song.track, duration: song.duration, plays: song.plays, skips: song.skips,
    lastPlayedDaysAgo: song.lastPlayedDaysAgo, lastSkippedDaysAgo: song.lastSkippedDaysAgo,
    audio: song.audio ? audioFiles[`../../../Design/Showcase/${song.audio}`] : undefined,
    lyrics: lyrics(song.lyrics),
  })),
})));
// The songs with music, which songs without any borrow from, lyrics and all.
const pool = library.flatMap((a) => a.songs.flatMap((s) => (s.audio ? [{ audio: s.audio, lyrics: s.lyrics }] : [])));

const repo = 'https://github.com/gouthamank/Beat';
// GitHub serves the newest release's Beat.dmg here; the release workflow always names it Beat.dmg.
const download = `${repo}/releases/latest/download/Beat.dmg`;
const buildSteps = `${repo}#building`;
const visualizerPoster = (await getImage({ src: visualizerFrame, width: 1600, format: 'webp' })).src;


const more = [
  { title: 'Gapless playback', text: 'Live albums and DJ mixes run straight on, with no gap between tracks.' },
  { title: 'AirPlay', text: 'Send music to your speakers, with Now Playing in Control Centre and media keys.' },
  { title: 'Last.fm', text: 'Scrobbles every song you play (opt-in), including plays made offline.' },
  { title: 'Artist info', text: 'Turn it on and artist pages get a bio, members, aliases and links from Discogs, and each artist their photo. Matched the wrong one? Pick the right artist.' },
  { title: 'Library Health', text: 'Identify duplicates, missing tags and artwork with ease.' },
  { title: 'Liquid Glass', text: 'At home on macOS and iOS 26, with frosted materials on macOS 15.' },
];
---

<Layout title="Beat: a local music player for Mac, iPhone and iPad"
        description="A local music player for Mac, iPhone and iPad that you can make your own: browse by label, mood or anything in your tags. Free and open source.">

  <header class="sticky top-0 z-30 border-b border-line bg-glass backdrop-blur-xl">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <Image src={icon} alt="" width={28} height={28} class="size-7" />
        Beat
      </a>
      <div class="flex items-center gap-5 text-sm text-soft">
        <a href="#pages" class="hidden hover:text-ink sm:inline">Features</a>
        <a href="#private" class="hidden hover:text-ink sm:inline">Privacy</a>
        <a href={repo} target="_blank" rel="noopener" class="hover:text-ink">GitHub</a>
        <a href="#get" class="rounded-full bg-ink px-3.5 py-1.5 font-medium text-bg hover:opacity-90">Get Beat</a>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative isolate overflow-hidden">
      <CoverWall />
      <div class="relative mx-auto flex max-w-3xl flex-col items-center px-4 pb-24 pt-24 text-center sm:px-6 sm:pt-32">
        <Image src={icon} alt="Beat's icon" width={112} height={112} class="size-24 drop-shadow-xl sm:size-28" loading="eager" />
        <h1 class="mt-8 font-display text-5xl font-bold tracking-tight sm:text-7xl">Enjoy your music<br />how you want to.</h1>
        <p class="mt-6 max-w-xl text-lg text-soft sm:text-xl">
          Apple's Music app is great for tagging, but listening on the desktop felt clunky. I needed a way to browse
          record labels' discographies, and there was no easy way short of making a playlist for each label. So I built
          Beat.
        </p>
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row">
          <a href="#get" class="rounded-full bg-accent px-6 py-3 font-semibold text-accent-ink shadow-lg hover:opacity-90">
            Download
          </a>
        </div>
        <a href="#demo" class="group mt-5 inline-flex items-center gap-2 text-sm font-semibold text-soft hover:text-ink">
          <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-accent"></span></span>
          Live demo
          <span aria-hidden="true" class="transition-transform group-hover:translate-y-0.5">↓</span>
        </a>
        <p class="mt-4 text-sm text-faint">Free and open source · macOS 15 or later · iOS 26</p>
      </div>
    </section>

    <!-- The interactive demo: a small working Beat, loaded as it scrolls into view. -->
    <section id="demo" class="mx-auto max-w-6xl scroll-mt-20 px-4 pb-24 sm:px-6 sm:pb-32">
      <div class="mb-6 pt-10 text-center">
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Go ahead, give it a try. This isn't a screenshot.</h2>
        <p class="mx-auto mt-2 max-w-xl text-soft">(yes, it plays music :))</p>
      </div>
      <div class="min-h-[720px]">
        <Demo client:only="react" albums={library} pool={pool} />
      </div>
      <!-- The demo's own buttons, drawn as they appear in it, with their names for screen readers. -->
      <p class="mt-16 text-center text-sm leading-7 text-soft">
        <span class="block">Click an album to open it and a song to play it.</span>
        <span class="block"><span class="inline-flex h-6 items-center gap-1 rounded-md border border-line px-1.5 align-middle text-ink"><Icon name="square.and.pencil" className="size-4" /><span class="sr-only">Edit Page</span></span>
          and <span class="inline-flex h-6 items-center gap-1 rounded-md border border-line px-1.5 align-middle text-ink"><Icon name="plus" className="size-4" /><span class="sr-only">Add Element</span></span>
          change a page’s elements.</span>
        <span class="block"><span class="inline-flex h-6 items-center gap-1 rounded-md border border-line px-1.5 align-middle text-ink"><Icon name="plus.circle" className="size-4" />New</span> adds pages and folders.</span>
      </p>
    </section>

    <!-- Pages built from smart filters: the headline feature -->
    <section id="pages" class="border-y border-line bg-raised">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
        <div class="max-w-2xl">
          <p class="font-semibold text-accent">Pages and smart filters</p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">Sorted by mood, then by label.</h2>
          <p class="mt-5 text-lg text-soft">
            Over a decade collecting digital music: hunting down rare releases on defunct webstores, tagging, finding
            decent album art, keeping a dedicated backup. It was quite a bit of effort, and I wasn't satisfied with the tags Music exposed to
            me.
          </p>
          <p class="mt-4 text-lg text-soft">
            If you ever wanted a way to group your library beyond the standard Album Artist / Genre / Songs list, this is
            what you'd use. Customisable not just in scope but appearance.
          </p>
        </div>
        <div class="mt-10">
          <LayoutShots />
        </div>
        <!-- Rules: what a smart filter's filter steps can do -->
        <div class="mt-24 grid items-center gap-12 lg:grid-cols-[3fr_2fr]">
          <div>
            <h3 class="font-display text-3xl font-bold tracking-tight">Filters as simple, nested or complex as you need.</h3>
            <p class="mt-4 text-lg text-soft">
              If an artist has songs spread across various compilation albums, it's very easy to group those releases
              together on one page.
            </p>
            <button type="button" data-demo-run="smart-filter"
                    class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full border border-line bg-bg px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent">
              Edit a smart filter <span aria-hidden="true">↑</span>
            </button>
          </div>
          <Shot name="smart-filter-mac" alt="The smart filter editor: an artist's songs with a nested group leaving out remixes and one album, newest first" class="lg:order-first" />
        </div>
        <!-- Custom fields: sorting by a value pulled out of a tag -->
        <div class="mt-24 grid items-center gap-12 lg:grid-cols-[2fr_3fr]">
          <div>
            <h3 class="font-display text-3xl font-bold tracking-tight">Browse a label in catalog order.</h3>
            <p class="mt-4 text-lg text-soft">
              Ever wanted releases in an order other than album artist or year? A custom field pulls a value out of a tag
              you already have, like the album title, comments or grouping, and sorts by it.
            </p>
            <p class="mt-4 text-lg text-soft">
              When I was in the mood for something from Warp Records, I had to filter for “(WAP” or “(WARP”. I don't need to
              any more with Beat.
            </p>
            <p class="mt-4 text-lg text-soft">
              In my library, the catalog number sits in brackets after the album title. A custom field pulls it out, so a
              label's releases sort in catalog order, even when several came out the same year.
            </p>
            <button type="button" data-demo-run="custom-field"
                    class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full border border-line bg-bg px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent">
              Try it in the demo <span aria-hidden="true">↑</span>
            </button>
          </div>
          <!-- A sheet captured at 2x: shown no wider than it is in the app, so it stays sharp. -->
          <Shot name="custom-field-mac" alt="A custom field that reads the catalog number from the comments, with a live check of what it finds"
                class="mx-auto max-w-[480px]" />
        </div>
      </div>
    </section>

    <!-- Now Playing -->
    <section>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 sm:py-32 lg:grid-cols-2">
        <div>
          <p class="font-semibold text-accent">Now Playing</p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">An app themed to your album art. If you want it.</h2>
          <p class="mt-5 text-lg text-soft">
            The album art's colours bleed into the whole app, so it matches the mood of the track you're listening to.
            It's not for everyone, so you can toggle it off.
          </p>
        </div>
        <Shot name="now-playing-mac" alt="Now Playing with synced lyrics, coloured by the album's cover" />
      </div>
    </section>

    <!-- Visualizers -->
    <section id="visualizers" class="border-y border-line bg-raised">
      <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-32">
        <p class="font-semibold text-accent">Visualizers</p>
        <h2 class="mx-auto mt-2 max-w-2xl font-display text-4xl font-bold tracking-tight sm:text-5xl">Do you miss visualizers too?</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-soft">
          Beat has them. Simple bars to a starfield, all coloured by the album that's playing.
        </p>
        <button type="button" data-demo-run="visualizer"
                class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full border border-line bg-bg px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent">
          Open the visualizer <span aria-hidden="true">↑</span>
        </button>
        <!-- A short muted loop of the real visualizer, cut where its last frame matches its first, with that frame shown
             while it loads; with Reduce Motion on, the frame stays and the video never plays. -->
        <video data-motion-video data-tilt autoplay muted loop playsinline disablepictureinpicture disableremoteplayback
               preload="metadata" poster={visualizerPoster}
               width="1600" height="1118" aria-label="The Horizon visualizer in Beat on the Mac: spectrum bars as a skyline under a setting sun, moving with the music"
               class="mt-12 block h-auto w-full overflow-hidden rounded-xl shadow-[0_20px_60px_rgb(0_0_0/0.22)] ring-1 ring-line">
          <source src={visualizerVideo} type="video/mp4" />
        </video>
      </div>
    </section>

    <!-- Lyrics -->
    <section id="lyrics" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-[2fr_3fr]">
        <div>
          <p class="font-semibold text-accent">Lyrics</p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">Lyrics that keep time.</h2>
          <p class="mt-5 text-lg text-soft">
            Synced lyrics follow the song as it plays, and clicking a line jumps there. Give a DJ mix a timestamped
            tracklist, and Beat marks each track on the progress bar, so you can jump straight to your favourite tracks in
            the mix.
          </p>
          <button type="button" data-demo-run="lyrics"
                  class="mt-6 inline-flex cursor-pointer items-center gap-2 rounded-full border border-line bg-bg px-4 py-2 text-sm font-medium transition-colors hover:border-accent hover:text-accent">
            Play a song with lyrics <span aria-hidden="true">↑</span>
          </button>
        </div>
        <!-- Two shots stacked like cards: lyrics behind, top left; the DJ mix in front, bottom right, so its tracklist leads. -->
        <div class="relative aspect-[4/3]">
          <Shot name="lyrics-mac" alt="Synced lyrics in Now Playing, the current line highlighted" class="w-[80%]" />
          <Shot name="mix-mac" alt="A DJ mix in Now Playing: its tracklist beside the cover, each track marked along the progress bar, and the track under the pointer named above it"
                class="absolute bottom-0 right-0 w-[66%]" />
        </div>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-line bg-raised p-6">
          <h3 class="font-semibold">From your files first</h3>
          <p class="mt-2 text-soft">An .lrc file beside the song, or lyrics added in Music's Get Info. Beat only looks online for songs whose files have no synced lyrics.</p>
        </div>
        <div class="rounded-2xl border border-line bg-raised p-6">
          <h3 class="font-semibold">Online, if you want</h3>
          <p class="mt-2 text-soft">Turn it on and Beat asks LRCLIB for synced lyrics, sending only the song's artist, title, album and length. Answers are saved, so a song isn't looked up every time it plays.</p>
        </div>
        <div class="rounded-2xl border border-line bg-raised p-6">
          <h3 class="font-semibold">Never written back</h3>
          <p class="mt-2 text-soft">Lyrics found online stay in Beat. Your files and your Music library aren't touched.</p>
        </div>
      </div>
    </section>


    <!-- Quick Open -->
    <section id="quick-open" class="border-y border-line bg-raised">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-24 sm:px-6 sm:py-32 lg:grid-cols-[2fr_3fr]">
        <div>
          <p class="font-semibold text-accent">Quick Open</p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">Spotlight… for your music.</h2>
          <p class="mt-5 text-lg text-soft">
            Open it from anywhere and start typing what you have in mind: an album, artist, song, genre or one of your
            pages. It's faster than switching tabs and using the search box in the corner.
          </p>
          <p class="mt-4 text-sm text-faint">⌘K on the Mac. The search button in the sidebar on iPad and iPhone.</p>
        </div>
        <Shot name="quick-open-mac" alt="Quick Open over Home, finding albums and songs for “night”" />
      </div>
    </section>

    <!-- Every device -->
    <section>
      <div class="mx-auto max-w-6xl px-4 py-24 text-center sm:px-6 sm:py-32">
        <p class="font-semibold text-accent">Cross-platform support</p>
        <h2 class="mx-auto mt-2 max-w-2xl font-display text-4xl font-bold tracking-tight sm:text-5xl">Beat works the same across your Mac, iPhone and iPad.</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-soft">
          On the Mac it plays the Music app's library, and on mobile, your synced music. Your preferences and setup are
          portable.
        </p>
        <DeviceMorph />
      </div>
    </section>

    <!-- Read-only and private -->
    <section id="private" class="border-y border-line bg-raised">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
        <div class="max-w-2xl">
          <p class="font-semibold text-accent">Read-only and private</p>
          <h2 class="mt-2 font-display text-4xl font-bold tracking-tight sm:text-5xl">Let others handle the tagging and imports. Beat just plays the music.</h2>
        </div>
        <div class="mt-12 grid gap-6 md:grid-cols-3">
          <div class="rounded-2xl border border-line bg-bg p-6">
            <h3 class="font-semibold">Never writes to Music</h3>
            <p class="mt-2 text-soft">Beat only reads your library. Its own play and skip counts live in a file of its own.</p>
          </div>
          <div class="rounded-2xl border border-line bg-bg p-6">
            <h3 class="font-semibold">Offline unless you say so</h3>
            <p class="mt-2 text-soft">Lyrics, artist info and scrobbling are off until you turn them on. No data collection of any kind.</p>
          </div>
          <div class="rounded-2xl border border-line bg-bg p-6">
            <h3 class="font-semibold">Your files, played locally</h3>
            <p class="mt-2 text-soft">Beat plays local, DRM-free files. Not designed for streaming music.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- And more -->
    <section>
      <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
        <h2 class="font-display text-3xl font-bold tracking-tight text-accent sm:text-4xl">And more.</h2>
        <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
          {more.map((item) => (
            <div>
              <h3 class="font-semibold text-accent">{item.title}</h3>
              <p class="mt-2 text-sm text-soft">{item.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Get Beat -->
    <section id="get" class="border-t border-line bg-raised">
      <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
        <h2 class="text-center font-display text-4xl font-bold tracking-tight sm:text-5xl">Get Beat.</h2>
        <p class="mt-4 text-center text-lg text-soft">Free and open source, under the MIT licence.</p>
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          <div class="flex flex-col rounded-3xl border border-line bg-bg p-8">
            <h3 class="text-xl font-semibold">Mac</h3>
            <p class="mt-1 text-sm text-faint">macOS 15 or later · Apple silicon and Intel</p>
            <p class="mt-6 text-soft">
              Beat isn't notarised by Apple (that needs a paid developer account), so macOS warns you the first time you
              open it. The source is on <a href={repo} target="_blank" rel="noopener" class="font-medium text-ink underline decoration-line underline-offset-4 hover:decoration-ink">GitHub</a> if you'd like to check it first.
            </p>
            <a href={download} class="mt-8 self-start rounded-full bg-accent px-6 py-3 font-semibold text-accent-ink hover:opacity-90">Download for Mac</a>
            <!-- The steps past macOS's warning, folded away: the line above says to expect it, and they're a click off. -->
            <details class="group mt-6">
              <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-soft hover:text-ink [&::-webkit-details-marker]:hidden">
                <span aria-hidden="true" class="transition-transform group-open:rotate-90">›</span>
                Trouble installing?
              </summary>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-soft">
                <li>Download Beat.dmg, open it and drag Beat to Applications.</li>
                <li>Open Beat. macOS says it can't check it for malicious software. Choose <strong class="text-ink">Done</strong>.</li>
                <li>Open <strong class="text-ink">System Settings › Privacy &amp; Security</strong>, scroll down and click <strong class="text-ink">Open Anyway</strong> next to Beat.</li>
              </ol>
            </details>
          </div>
          <div class="flex flex-col rounded-3xl border border-line bg-bg p-8">
            <h3 class="text-xl font-semibold">iPhone and iPad</h3>
            <p class="mt-1 text-sm text-faint">iOS 26 · built from source with Xcode</p>
            <p class="mt-6 text-soft">
              Beat isn't on the iOS App Store, but tinkerers can build it from source.
            </p>
            <a href={buildSteps} target="_blank" rel="noopener" class="mt-8 self-start rounded-full border border-line px-6 py-3 font-semibold hover:bg-raised">Build steps on GitHub</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 text-sm text-faint sm:px-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p>© 2026 Gouthaman Kumar · <a href={`${repo}/blob/main/LICENSE`} target="_blank" rel="noopener" class="hover:text-ink">MIT licence</a></p>
        <a href={repo} target="_blank" rel="noopener" class="hover:text-ink">Source on GitHub</a>
      </div>
      <p>The albums, artists and covers shown here are made up, apart from the DJ mix and its tracklist in the Lyrics section; no real album art is used.</p>
      <p>Apple, Mac, iPhone, iPad and other Apple product names are trademarks of Apple Inc. Beat isn't affiliated with or endorsed by Apple.</p>
      {credits.length > 0 && (
        <p>
          Music in the demo:{' '}
          {credits.map((credit, i) => (
            <>
              {i > 0 && ' · '}
              <a href={credit.url} class="hover:text-ink">“{credit.title}” by {credit.artist}</a> ({credit.license})
            </>
          ))}
        </p>
      )}
    </div>
  </footer>
<script>
  // Looping videos hold still on their first frame for anyone who asks for less motion.
  const lessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  for (const video of document.querySelectorAll<HTMLVideoElement>('[data-motion-video]')) {
    const apply = () => {
      if (lessMotion.matches) { video.pause(); video.currentTime = 0; } else void video.play().catch(() => {});
    };
    apply();
    lessMotion.addEventListener('change', apply);
    // It's a moving picture, not a player: no menu offering to pause, loop, save or show controls.
    video.addEventListener('contextmenu', (e) => e.preventDefault());
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-demo-run]')) {
    button.addEventListener('click', () => {
      document.getElementById('demo')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      window.dispatchEvent(new CustomEvent('beat-demo', { detail: button.dataset.demoRun }));
    });
  }
</script>
</Layout>
